# The Express API this app proxies to, server-side.
API_BACKEND_URL=http://localhost:3001

# Same host as above, but reaching the browser: it goes into the CSP's
# connect-src and is where the ticket board opens its WebSocket. The socket
# upgrade cannot be proxied the way fetch() calls are, so the browser talks to
# the API host directly for that one connection.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# Must be BYTE-IDENTICAL to the API's AUTH_SECRET. This app mints the
# 60-second socket ticket locally and lib/pos-ws.ts over there verifies it; a
# mismatch shows up as a board stuck on "Offline — retrying" and a
# "[socket-ticket] AUTH_SECRET is not set" or 4001 Auth failed in the logs.
AUTH_SECRET=

# Which screen this is. A real deployment pairs the device and stores this
# server-side instead of baking it into the bundle.
NEXT_PUBLIC_POS_TENANT_ID=
NEXT_PUBLIC_POS_LOCATION_ID=
